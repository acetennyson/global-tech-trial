# Supabase Postgres connection string (Project Settings -> Database -> Connection string -> URI).
# Use the pooled ("Transaction") connection string for serverless/multi-instance deploys.
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres
DB_CONNECTION_LIMIT=10
# Supabase's own cert isn't in Node's default trust store; set to "false" only if
# you've supplied a proper CA yourself.
DB_SSL_REJECT_UNAUTHORIZED=false

# TM-2: secret for signing/verifying JWTs issued by /api/auth/register and
# /api/auth/login (lib/auth/jwt.ts). Required — resolveAuthUser throws at
# request time if this is unset. Generate one with: openssl rand -base64 48
JWT_SECRET=
# Optional, defaults to 7d. Any value jsonwebtoken's `expiresIn` accepts.
JWT_EXPIRES_IN=7d

# Base URL used to build the link in the forgot-password email (lib/email).
APP_URL=http://localhost:3000

# Password reset email, sent via nodemailer (lib/email/sendPasswordResetEmail.ts).
# EMAIL_USER / EMAIL_PASSWORD: an email account + its password. For providers
# that require one (Gmail, etc.), this must be an app password, not the
# account's normal login password.
EMAIL_USER=
EMAIL_PASSWORD=
# nodemailer's built-in preset name. Defaults to "gmail" if unset.
EMAIL_SERVICE=gmail
# Optional: sender address, if different from EMAIL_USER.
EMAIL_FROM=
# For a provider without a nodemailer preset, set EMAIL_HOST (+ EMAIL_PORT,
# default 587) instead of EMAIL_SERVICE — that switches to plain SMTP.
EMAIL_HOST=
EMAIL_PORT=587

# Minimum log level: debug, info, warn, error or silent. Default: info.
LOG_LEVEL=info

# Tombstoned (soft-deleted) tasks older than this are permanently removed by `npm run db:purge`. Default 30 days.
# TOMBSTONE_RETENTION_SECONDS=2592000
